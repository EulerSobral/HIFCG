# ==========================================================
# HIFCG - Exemplo de Variáveis de Ambiente / Secrets
# No GitHub Actions, estes valores são injetados via Secrets
# ==========================================================

# Banco de Dados PostgreSQL
POSTGRES_DB=hifcgdb
POSTGRES_USER=hifcg
POSTGRES_PASSWORD=troque_por_uma_senha_forte_em_producao

# Configurações de Rede / Frontend
BACKEND_URL=http://backend:8080
VITE_API_URL=
FRONTEND_PORT=3000
